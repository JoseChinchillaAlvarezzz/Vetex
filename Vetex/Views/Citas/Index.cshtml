@model List<Vetex.Models.CitaDelDiaVM>
@{
    ViewData["Title"] = "Citas del día";
    string filtroTexto = (string)(ViewBag.FiltroTexto ?? "Todas las citas");
    var fechaFiltro = (DateTime?)ViewBag.FechaFiltro;
}

<style>
    .frame {
        max-width: 980px;
        margin: 40px auto;
        background: #2b90b6;
        padding: 18px;
        border-radius: 16px
    }

    .panel {
        position: relative;
        background: #e0e0e0;
        border-radius: 12px;
        padding: 22px
    }

    .header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 12px
    }

    .title {
        font-weight: 800;
        font-size: 28px;
        color: #1a1a1a;
        margin: 0
    }

    .date {
        font-weight: 600;
        color: #2a2a2a
    }

    .spacer {
        flex: 1
    }

    .btn-new {
        background: #2b9ed9;
        color: #fff;
        font-weight: 700;
        border: none;
        padding: 10px 18px;
        border-radius: 10px;
        cursor: pointer
    }

        .btn-new:hover {
            filter: brightness(.95)
        }

    .table-wrap {
        margin-top: 10px;
        background: #eee;
        border-radius: 8px;
        padding: 12px
    }

    table.citas {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        background: #f5f5f5;
        border: 1px solid #cfcfcf
    }

    .citas thead th {
        background: #f6f6f6;
        font-weight: 800;
        color: #333;
        padding: 10px 12px;
        border-bottom: 1px solid #cfcfcf
    }

    .citas tbody td {
        padding: 10px 12px;
        border-top: 1px solid #d7d7d7;
        border-left: 1px solid #e3e3e3
    }

    .citas tbody tr:first-child td {
        border-top: 1px solid #cfcfcf
    }

    .citas tbody td:first-child {
        border-left: none
    }

    .citas tbody tr:nth-child(odd) td {
        background: #fafafa
    }

    .citas tbody tr:nth-child(even) td {
        background: #f0f0f0
    }

    .code-link {
        color: #2b9ed9;
        font-weight: 700;
        text-decoration: none
    }

        .code-link:hover {
            text-decoration: underline
        }
</style>

<div class="frame">
    <div class="panel">
        <div class="header">
            <h2 class="title">Citas del día</h2>
            <span class="date">@filtroTexto</span>
            <div class="spacer"></div>
            <a asp-controller="Citas" asp-action="Crear_cita" class="btn btn-new">Nueva cita</a>
        </div>

        <!-- Filtro por fecha (opcional) -->
        <form asp-action="Index" asp-controller="Citas" method="get" class="mb-2" style="display:flex;gap:8px;align-items:center">
            <label for="fecha" style="font-weight:700;color:#222">Ver fecha:</label>
            <input type="date" id="fecha" name="fecha"
                   value="@(fechaFiltro.HasValue ? fechaFiltro.Value.ToString("yyyy-MM-dd") : "")"
                   class="form-control" style="max-width:200px" />
            <button type="submit" class="btn btn-new">Ir</button>
        </form>


        <div class="table-wrap">
            <table class="citas">
                <thead>
                    <tr>
                        <th style="width:12%;">Código</th>
                        <th style="width:14%;">Fecha</th>        <!-- NUEVA -->
                        <th style="width:20%;">Tipo de cita</th>
                        <th style="width:22%;">Dueño</th>
                        <th style="width:20%;">Mascota</th>
                        <th style="width:14%;">Hora</th>
                    </tr>
                </thead>
                <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var c in Model)
                {
                            <tr>
                                <td><a href="#" class="code-link">#@c.Codigo</a></td>
                                <td>@c.Fecha.ToString("dd/MM/yyyy")</td> <!-- NUEVA -->
                                <td>@c.TipoCita</td>
                                <td>@c.Dueno</td>
                                <td>@c.Mascota</td>
                                <td>@c.Hora</td>
                            </tr>
                }
            }
            else
            {
                        <tr>
                            <td colspan="6" style="text-align:center;padding:14px;">
                                No hay citas para el criterio seleccionado.
                            </td>
                        </tr>
            }
                </tbody>
            </table>
        </div>
    </div>
</div>