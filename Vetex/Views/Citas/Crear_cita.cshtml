@model Vetex.Models.CrearCitaVM
@{
    ViewData["Title"] = "Nueva cita";
    var hoy = Model.Fecha;
}


<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<form asp-action="Crear_cita" method="post" class="create-wrap">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MascotaId" />
    <input type="hidden" asp-for="TipoCitaId" />

    <div class="frame">
        <div class="panel">

           
            <div class="top-row">
                <div class="search-col">
                    <div class="field">
                        <label>Dueño:</label>
                        <div class="searchbox">
                            <input id="txtBusqueda" class="input" type="text" placeholder="Buscar dueño o mascota..." autocomplete="off" />
                            <button type="button" id="btnBuscar" class="icon-btn" title="Buscar">🔎</button>
                        </div>
                    </div>

                    <div class="field">
                        <label>Mascota:</label>
                        <div class="searchbox">
                            <input id="txtMascotaSolo" class="input" type="text" placeholder="(opcional) Filtrar por mascota..." autocomplete="off" />
                            <button type="button" id="btnBuscarMascota" class="icon-btn" title="Buscar mascota">🔎</button>
                        </div>
                    </div>

                    <div id="results" class="results"></div>

                    <div class="picked">
                        <span class="picked-label">Seleccionado:</span>
                        <span id="lblSeleccion" class="picked-value">(ninguno)</span>
                        <span asp-validation-for="MascotaId" class="text-danger ms-2"></span>
                    </div>
                </div>

                <div class="title-col">
                    <h2>Que Necesitas Hoy</h2>
                    <div class="chips">
                        @foreach (var t in Model.Tipos)
                        {
                            <div class="chip @(Model.TipoCitaId==t.Id?"active":"")" data-id="@t.Id">@t.Texto</div>
                        }
                    </div>
                    <span asp-validation-for="TipoCitaId" class="text-danger"></span>
                </div>

                <div class="brand-col">
                    <div class="brand">Vetex</div>
                </div>
            </div>

            <!-- Subtítulo selección de hora -->
            <div class="subcard">
                <div class="sub-title">Selección de hora</div>
                <small id="lblFechaSub">Mostrando los horarios para el @hoy.ToString("d 'de' MMMM 'de' yyyy")</small>
            </div>

            <!-- Cuerpo principal: calendario (izq) / horas (der) -->
            <div class="grid">
                <!-- IZQUIERDA -->
                <div class="left">
                    <!-- “Calendario” con input date -->
                    <div class="calendar">
                        <div class="calendar-head">
                            <div class="calendar-title">@hoy.ToString("ddd, MMM dd")</div>
                        </div>
                        <div class="calendar-body">
                            <input asp-for="Fecha" id="fecha" type="date" class="date-input" />
                        </div>
                        <span asp-validation-for="Fecha" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-primary">Agendar cita</button>
                </div>

                <!-- DERECHA -->
                <div class="right">
                    <div class="hours-card">
                        <ul class="hours-list">
                            @foreach (var h in Model.Horas)
                            {
                                <li class="hour-row">
                                    <span class="hour-text">@h.Texto</span>
                                    <input class="hour-radio" type="radio" name="HoraCitaId" value="@h.Id" @(Model.HoraCitaId == h.Id ? "checked" : "") />
                                </li>
                            }
                        </ul>
                        <span asp-validation-for="HoraCitaId" class="text-danger"></span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // =================== Utilidades ===================
        function formatLatinDateLocal(yyyyMMdd) {
            if (!yyyyMMdd) return '';
            const [y, m, d] = yyyyMMdd.split('-').map(Number);
            // Crear fecha en hora local (no UTC)
            const date = new Date(y, m - 1, d);
            return date.toLocaleDateString('es-SV', {
                day: 'numeric',
                month: 'long',
                year: 'numeric'
            });
        }

        const buscarUrl = '@Url.Action("Buscar", "Citas")';

        const fechaInput        = document.getElementById('fecha');
        const lblFechaSub       = document.getElementById('lblFechaSub');
        const chips             = document.querySelectorAll('.chip');
        const hiddenTipo        = document.querySelector('input[name="TipoCitaId"]');
        const hiddenMascota     = document.querySelector('input[name="MascotaId"]');
        const radiosHora        = document.querySelectorAll('input[name="HoraCitaId"]');
        const txtBusqueda       = document.getElementById('txtBusqueda');
        const txtMascotaSolo    = document.getElementById('txtMascotaSolo');
        const btnBuscar         = document.getElementById('btnBuscar');
        const btnBuscarMascota  = document.getElementById('btnBuscarMascota');
        const results           = document.getElementById('results');
        const lblSeleccion      = document.getElementById('lblSeleccion');

        document.addEventListener('DOMContentLoaded', () => {
            const activeChip = document.querySelector('.chip.active');
            if (activeChip && hiddenTipo)
                hiddenTipo.value = activeChip.getAttribute('data-id');

            if (radiosHora && radiosHora.length > 0) {
                const checked = Array.from(radiosHora).some(r => r.checked);
                if (!checked) radiosHora[0].checked = true;
            }

            if (fechaInput && lblFechaSub && fechaInput.value) {
                lblFechaSub.textContent = 'Mostrando los horarios para el ' +
                    formatLatinDateLocal(fechaInput.value);
            }
        });

        if (chips && chips.length > 0) {
            chips.forEach(ch => {
                ch.addEventListener('click', () => {
                    chips.forEach(x => x.classList.remove('active'));
                    ch.classList.add('active');
                    if (hiddenTipo) hiddenTipo.value = ch.getAttribute('data-id');
                });
            });
        }

        // ---------- FECHA sin desfase ----------
        if (fechaInput && lblFechaSub) {
            fechaInput.addEventListener('change', () => {
                if (fechaInput.value) {
                    lblFechaSub.textContent = 'Mostrando los horarios para el ' +
                        formatLatinDateLocal(fechaInput.value);
                }
            });
        }

        // --- Autocomplete y demás funciones (no toques esto, sigue igual) ---
        function renderResults(items) {
            if (!results) return;
            if (!items || items.length === 0) {
                results.innerHTML = '<div class="row empty">Sin resultados</div>';
                results.style.display = 'block';
                return;
            }
            results.innerHTML = items.map(it => `
                <div class="row" data-id="${it.id}" data-text="${it.texto}">
                    ${it.texto}
                </div>
            `).join('');
            results.style.display = 'block';
            results.querySelectorAll('.row').forEach(r => {
                r.addEventListener('click', () => {
                    if (hiddenMascota) hiddenMascota.value = r.getAttribute('data-id');
                    if (lblSeleccion) lblSeleccion.textContent = r.getAttribute('data-text');
                    results.style.display = 'none';
                });
            });
        }

        function buscar(q) {
            if (!results) return;
            if (!q || q.trim().length === 0) {
                results.style.display = 'none';
                results.innerHTML = '';
                return;
            }
            fetch(`${buscarUrl}?q=${encodeURIComponent(q)}`)
                .then(resp => resp.json())
                .then(renderResults)
                .catch(() => {
                    results.innerHTML = '<div class="row error">Error al buscar</div>';
                    results.style.display = 'block';
                });
        }

        let t1 = null, t2 = null;
        if (txtBusqueda) txtBusqueda.addEventListener('input', () => { clearTimeout(t1); t1 = setTimeout(() => buscar(txtBusqueda.value), 250); });
        if (txtMascotaSolo) txtMascotaSolo.addEventListener('input', () => { clearTimeout(t2); t2 = setTimeout(() => buscar(txtMascotaSolo.value), 250); });
        if (btnBuscar) btnBuscar.addEventListener('click', () => buscar(txtBusqueda.value));
        if (btnBuscarMascota) btnBuscarMascota.addEventListener('click', () => buscar(txtMascotaSolo.value));

        document.addEventListener('click', (e) => {
            if (!results) return;
            const fuera = !results.contains(e.target)
                && e.target !== txtBusqueda && e.target !== txtMascotaSolo
                && e.target !== btnBuscar && e.target !== btnBuscarMascota;
            if (fuera) results.style.display = 'none';
        });
    </script>
}







<style>
    :root{
        --brand:#2b9ed9;
        --bg:#d9d9d9;
        --panel:#e0e0e0;
        --card:#f6f2f6;
        --text:#1a1a1a;
        --muted:#666;
        --border:#cfcfcf;
    }
    .create-wrap{ margin:0; }

    /* Marco azul y panel gris como el mockup */
    .frame{
        max-width:1100px;
        margin:24px auto;
        background:var(--brand);
        padding:18px;
        border-radius:16px;
    }
    .panel{
        background:var(--panel);
        border-radius:14px;
        padding:18px;
        position:relative;
    }

    /* Fila superior */
    .top-row{
        display:grid;
        grid-template-columns: 340px 1fr 120px;
        gap:18px;
        align-items:center;
    }

    .search-col .field{ margin-bottom:10px; }
    .search-col label{
        display:block;
        font-weight:800;
        color:#222;
        margin-bottom:6px;
    }
    .searchbox{ display:flex; align-items:center; gap:8px; }
    .input{
        background:#fff; border:2px solid var(--border); border-radius:6px;
        padding:8px 10px; width:100%;
    }
    .icon-btn{
        border:none; background:var(--brand); color:#fff; border-radius:8px;
        padding:8px 10px; font-weight:700; cursor:pointer;
    }
    .icon-btn:hover{ filter:brightness(.95); }

    .results{
        display:none; background:#fff; border:1px solid #ddd; border-radius:8px;
        max-height:220px; overflow:auto; margin-top:8px;
    }
    .results .row{ padding:8px 10px; cursor:pointer; border-bottom:1px solid #eee; }
    .results .row:hover{ background:#f5faff; }
    .results .row.empty{ color:var(--muted); cursor:default; }
    .results .row.error{ color:#b00020; cursor:default; }

    .picked{ margin-top:8px; }
    .picked-label{ font-weight:800; color:#222; }
    .picked-value{ font-weight:700; margin-left:6px; color:#222; }

    .title-col{ text-align:center; }
    .title-col h2{ margin:0; font-weight:800; }
    .chips{ display:flex; gap:10px; justify-content:center; margin-top:8px; flex-wrap:wrap; }
    .chip{
        border:2px solid #a5a5a5; background:#f5f5f5; padding:6px 12px;
        border-radius:8px; font-weight:600; cursor:pointer; user-select:none;
    }
    .chip.active{ background:var(--brand); border-color:var(--brand); color:#fff; }

    .brand-col{ display:flex; justify-content:center; }
    .brand{ font-weight:800; font-size:22px; color:var(--brand); }

    .subcard{
        background:#eae2e7; border-radius:12px; padding:12px;
        text-align:center; margin:12px auto 16px; max-width:520px;
    }
    .sub-title{ font-weight:800; margin-bottom:4px; }
    .subcard small{ color:#5a5a5a; font-weight:600; }

    /* Grid principal */
    .grid{
        display:grid; grid-template-columns: 360px 1fr; gap:24px;
    }

    /* Calendario estilo tarjeta */
    .calendar{
        background:#ffffff; border-radius:14px; padding:14px; border:1px solid #ddd;
        box-shadow:0 1px 0 rgba(0,0,0,.04) inset;
        margin-bottom:14px;
    }
    .calendar-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; }
    .calendar-title{ font-weight:700; color:#333; }
    .date-input{
        width:100%; padding:10px; border-radius:8px; border:1px solid var(--border); background:#fff;
        font-weight:600;
    }

    .btn-primary{
        background:var(--brand); color:#fff; border:none; border-radius:10px;
        padding:12px 20px; font-weight:700; min-width:180px;
    }
    .btn-primary:hover{ filter:brightness(.95); }

    /* Horas a la derecha */
    .hours-card{
        background:#fff; border-radius:20px; padding:16px; border:1px solid #ddd;
    }
    .hours-list{ list-style:none; margin:0; padding:0 8px; max-height:470px; overflow:auto; }
    .hour-row{
        display:grid; grid-template-columns: 1fr auto; align-items:center;
        padding:10px 6px; border-bottom:1px solid #ececec; font-weight:600; color:#303030;
    }
    .hour-row:last-child{ border-bottom:none; }
    .hour-radio{ width:18px; height:18px; }
    .hour-text{ user-select:none; }

</style>
