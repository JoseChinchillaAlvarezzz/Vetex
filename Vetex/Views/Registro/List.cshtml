@model Vetex.Models.RegistroListaVM
@{
    ViewData["Title"] = "Ver registros";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            background: #2b90b6;
        }

        .panel {
            max-width: 1100px;
            background: #e3e3e3;
            margin: 24px auto;
            border-radius: 14px;
            padding: 18px
        }

        .row-item {
            background: #f5f5f5;
            border-radius: 10px;
            padding: .6rem 1rem
        }

        .btn-ver {
            background: #5aa9e6;
            border: none;
            padding: .25rem .9rem
        }

        .small-lbl {
            font-size: .9rem;
            color: #555
        }

        .search-icon {
            position: absolute;
            right: .6rem;
            top: .45rem;
            opacity: .6
        }

        .back-icon {
            font-size: 1.8rem; /* tamaño del icono */
            color: black; /* blanco */
            transition: transform .2s ease, color .2s ease;
            cursor: pointer;
        }

            .back-icon:hover {
                transform: scale(1.12);
                color: #eaeaea; /* aclarado en hover */
            }

    </style>
</head>
<body>
    <div class="panel">
        <div class="d-flex align-items-center mb-3">
            <a asp-controller="Registro" asp-action="Index" class="text-decoration-none" aria-label="Volver">
                <i class="bi bi-arrow-left-circle-fill back-icon"></i>
            </a>
            <h5 class="fw-semibold mb-0 ms-2 text-dark">Registros Clínicos</h5>
        </div>

        

        <form method="get" asp-action="List" class="row g-3 mb-3">
            <div class="col-md-6 position-relative">
                <label class="small-lbl">Dueño:</label>
                <input name="ownerName" value="@Model.OwnerName" class="form-control form-control-sm" placeholder="Ej: Maria Lopez" />
                <span class="search-icon">🔎</span>
            </div>
            <div class="col-md-6 position-relative">
                <label class="small-lbl">Mascota:</label>
                <input name="petName" value="@Model.PetName" class="form-control form-control-sm" placeholder="Ej: Toby" />
                <span class="search-icon">🔎</span>
            </div>
            <div class="col-12 d-flex justify-content-between">
                <!-- Botón Limpiar/Recargar -->
                <a class="btn btn-light btn-sm" asp-action="List">
                    Limpiar filtros
                </a>

                <!-- Botón Buscar -->
                <button class="btn btn-sm btn-secondary">Buscar</button>
            </div>
        </form>

        <div class="row fw-semibold px-2 mb-2">
            <div class="col-md-3">Dueño</div>
            <div class="col-md-3">Teléfono</div>
            <div class="col-md-2">DUI</div>
            <div class="col-md-2">Mascota</div>
            <div class="col-md-2 text-end">Acciones</div>
        </div>

        @if (Model.Filas.Any())
        {
            foreach (var f in Model.Filas)
            {
                <div class="row align-items-center row-item mb-2">
                    <div class="col-md-3">@f.Dueno</div>
                    <div class="col-md-3">@f.Telefono</div>
                    <div class="col-md-2">@f.Dui</div>
                    <div class="col-md-2">@f.Mascota</div>
                    <div class="col-md-2 text-end">
                        <a class="btn btn-ver btn-sm"
                           asp-action="History"
                           asp-route-duenoId="@f.DuenoId"
                           asp-route-mascotaId="@f.MascotaId">Ver</a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-light">Sin resultados.</div>
        }
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
