@{
    ViewData["Title"] = "Registros Clínicos";
    Layout = null; 
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body{background:#2b90b6;}
        .card-wrap{
            max-width:900px;margin:30px auto;background:#e3e3e3;border-radius:14px;
            padding:28px;box-shadow:0 2px 6px rgba(0,0,0,.15)
        }

        .btn-vetex {
            background: #3D90B9;
            border: none
            text-color:
        }
        .btn-vetex:hover{filter:brightness(.95)}
        .logo{width:70px}
        .title{font-weight:700;margin-top:8px}
    </style>
</head>
<body>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show text-center fw-semibold" role="alert"
             style="max-width:600px;margin:20px auto;border-radius:10px;">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card-wrap text-center">

        <div class="mx-5 mb-5 pb-5">
            <a asp-controller="Login" asp-action="menuInicial" class="btn text-light text-center mx-5 mt-4" style="background-color:#3D90B9;">
                <-- Volver a la pantalla principal
            </a>
        </div>

        <img src="@Url.Content("~/images/Vetex-removebg-preview.png")" alt="Vetex" class="text-center" style="width:150px;" />

        <h5 class="fw-semibold mb-4">Registros Clínicos</h5>
        <div class="d-flex gap-3 justify-content-center">
            <a class="btn btn-vetex px-4 text-white" asp-controller="Registro" asp-action="List">Ver registros</a>
            <a class="btn btn-vetex px-4 text-white" asp-controller="Registro" asp-action="Create">Registro nuevo</a>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        setTimeout(() => {
            const alert = document.querySelector('.alert');
            if (alert) {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }
        }, 3000); // 3 segundos
    </script>

</body>
</html>
