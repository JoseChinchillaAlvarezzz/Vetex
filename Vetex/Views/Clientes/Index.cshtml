@model IEnumerable<dynamic>
@{
    Layout = null;
    ViewData["Title"] = "Gestión de clientes";
    var q = (string?)ViewBag.Q ?? "";

   
    Func<string?, string> PetEmoji = (string? especieRaw) =>
    {
        var e = (especieRaw ?? "").Trim().ToLower();
        return e switch
        {
            "perro" or "canino" or "dog" => "🐶",
            "gato" or "felino" or "cat" => "🐱",
            "conejo" => "🐰",
            "tortuga" => "🐢",
            "pez" or "fish" => "🐟",
            "ave" or "pajaro" or "pájaro" => "🐦",
            "hamster" or "hámster" => "🐹",
            _ => "🐾"
        };
    };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <style>
      
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: Segoe UI, Roboto, Arial, sans-serif;
        }

        .bg-cover {
            background: #3A869F;
            min-height: 100vh; 
            width: 100%;
            display: flex;
            justify-content: center;
            padding-top: 50px;
            padding-bottom: 50px;
            box-sizing: border-box;
        }

        .card-shell {
            width: 1120px;
            max-width: calc(100% - 32px);
            background: #e6e6e6;
            border-radius: 22px;
            padding: 26px 28px 34px;
            box-shadow: 0 10px 32px rgba(0,0,0,.12);
            position: relative;
        }

        .brand-top {
            position: absolute;
            right: 26px;
            top: 20px;
        }

            .brand-top img {
                height: 56px;
                display: block;
            }

        .title-main {
            text-align: center;
            font-size: 62px;
            font-weight: 800;
            margin: 8px 0 24px;
            color: #3A869F;
            letter-spacing: .5px;
        }

        .new-btn-wrap {
            width: 100%;
            display: flex;
            justify-content: center;
            margin-bottom: 18px;
        }

        .btn-new {
            display: inline-block;
            padding: 12px 26px;
            border-radius: 12px;
            background: #3A86B6;
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            border: 1px solid rgba(0,0,0,.25);
            box-shadow: 0 3px 0 rgba(0,0,0,.25);
            transition: transform .05s ease, background .15s ease;
        }

            .btn-new:hover {
                background: #2f78a4;
                color: #fff;
            }

            .btn-new:active {
                transform: translateY(1px);
                box-shadow: 0 2px 0 rgba(0,0,0,.25);
            }

        .search-row {
            margin: 18px 0 14px;
        }

            .search-row input {
                width: 100%;
                height: 40px;
                border-radius: 8px;
                border: 1px solid #cfcfcf;
                background: #fff;
                color: #333;
                padding: 8px 12px;
                box-sizing: border-box;
            }

        .table-wrap {
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
        }

        table.clean {
            width: 100%;
            border-collapse: collapse;
        }

        .clean thead th {
            background: #efefef;
            padding: 12px 14px;
            text-align: left;
            color: #52606a;
            font-weight: 800;
            border-bottom: 1px solid #e0e0e0;
        }

        .clean tbody td {
            padding: 18px 14px;
            color: #2f3a43;
            border-bottom: 1px solid #f0f0f0;
            vertical-align: top;
        }

        .clean tbody tr:last-child td {
            border-bottom: none;
        }

        .pets-list {
            margin: 0;
            padding-left: 22px;
        }

            .pets-list li {
                margin: 4px 0;
            }

        .actions {
            display: flex;
            gap: 10px;
        }

        .btn-pill {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 70px;
            border: none;
            padding: 9px 16px;
            border-radius: 12px;
            font-weight: 700;
            text-decoration: none;
            color: #fff;
            background: #2980d4;
            box-shadow: 0 3px 0 rgba(0,0,0,.25);
        }

            .btn-pill:hover {
                background: #226db3;
            }

        ) {
            .title-main

        {
            font-size: 40px;
        }

        }
    </style>
</head>

<body>
    <div class="bg-cover">
        <div class="card-shell">
            <div class="brand-top">
                <img src="~/images/Vetex-removebg-preview.png" alt="Vetex" />
            </div>

            <h1 class="title-main">Gestión de clientes</h1>

            <div class="new-btn-wrap">
                <a asp-action="Registro_Dueno" class="btn-new">+ Nuevo dueño</a>
            </div>

            <form method="get" class="search-row">
                <input name="q" value="@q" placeholder="Buscar dueño..." />
            </form>

            <div class="table-wrap">
                <table class="clean">
                    <thead>
                        <tr>
                            <th style="width:35%;">Nombre</th>
                            <th style="width:20%;">Teléfono</th>
                            <th style="width:30%;">Mascotas</th>
                            <th style="width:15%;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="4" style="text-align:center; color:#7a8791; padding:26px 12px;">
                                    No hay resultados @(!string.IsNullOrWhiteSpace(q) ? $"para \"{q}\"" : "").
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var c in Model)
                            {
                                <tr>
                                    <td>@c.nombre</td>
                                    <td>@(string.IsNullOrWhiteSpace(c.telefono) ? "—" : c.telefono)</td>
                                    <td>
                                        @if (c.Mascotas == null || c.Mascotas.Count == 0)
                                        {
                                            <span class="text-muted">Sin mascotas</span>
                                        }
                                        else
                                        {
                                            <ul class="pets-list">
                                                @foreach (var m in c.Mascotas)
                                                {
                                                    <li>@PetEmoji((string?)m.especie) @m.nombre</li>
                                                }
                                            </ul>
                                        }
                                    </td>
                                    <td>
                                        <div class="actions">
                                            <a class="btn-pill" asp-action="Editar_Datos" asp-route-id="@c.id">Editar</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
