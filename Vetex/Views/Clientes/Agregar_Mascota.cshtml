@model Vetex.Models.mascotas
@{
    Layout = null;
    ViewData["Title"] = "Agregar mascota";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <style>
        html, body {
            height: 100%;
            margin: 0;
            font-family: Segoe UI, Roboto, Arial, sans-serif;
            color: #2e3d47;
            background: #3A869F;
        }

        .container {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 48px 0;
            box-sizing: border-box;
        }

        .card-shell {
            width: 920px;
            max-width: 95%;
            background: #e6e6e6;
            border-radius: 18px;
            padding: 28px 38px 46px;
            box-shadow: 0 10px 32px rgba(0,0,0,.12);
            position: relative;
        }

        .brand-top {
            position: absolute;
            right: 20px;
            top: 16px;
        }

            .brand-top img {
                height: 50px;
            }

        .title-main {
            text-align: center;
            font-size: 40px;
            font-weight: 800;
            margin: 0 0 26px;
            color: #2e3d47;
        }

        .form-grid {
            max-width: 640px;
            margin: 0 auto;
        }

        .form-group {
            margin-bottom: 14px;
        }

        label {
            display: block;
            font-weight: 700;
            margin-bottom: 6px;
        }

        input, select {
            width: 100%;
            height: 42px;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid #cfcfcf;
            background: #fff;
            font-size: 16px;
            box-sizing: border-box;
        }

        .actions {
            text-align: center;
            margin-top: 20px;
        }

        .btn-save {
            background: #3d7df2;
            color: #fff;
            border: none;
            height: 46px;
            padding: 0 22px;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 3px 0 rgba(0,0,0,.25);
        }

            .btn-save:hover {
                background: #2e6be0;
            }

        .text-danger {
            color: #b33a3a;
        }

        .input-error {
            border: 2px solid #b33a3a !important;
            background-color: #ffeaea !important;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="card-shell">
            <div class="brand-top">
                <img src="~/images/Vetex-removebg-preview.png" alt="Vetex" />
            </div>

            <h1 class="title-main">Agregar Mascota</h1>

            <form asp-action="Agregar_Mascota" method="post" novalidate class="form-grid">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="dueno_id" />

                <div class="form-group">
                    <label asp-for="nombre">Nombre:</label>
                    <input asp-for="nombre" type="text" required />
                </div>

                <div class="form-group">
                    <label>Especie:</label>
                    <select asp-for="especie_id" asp-items="ViewBag.Especies" required>
                        <option value="">-- Seleccione --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="raza">Raza:</label>
                    <input asp-for="raza" type="text" />
                </div>

                <div class="form-group">
                    <label>Sexo:</label>
                    <select asp-for="sexo_id" asp-items="ViewBag.Sexos" required>
                        <option value="">-- Seleccione --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="fecha_nacimiento">Fecha de nacimiento:</label>
                    <input asp-for="fecha_nacimiento"
                           type="date"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")"
                           required />
                </div>

                <div class="form-group">
                    <label asp-for="peso">Peso (lb):</label>
                    <input asp-for="peso" type="number" min="1" max="350" required />
                </div>

                <div class="actions">
                    <button type="submit" class="btn-save">Guardar</button>
                </div>
            </form>

        </div>
    </div>

    <script>
        document.querySelector("form").addEventListener("submit", function (e) {
            let valid = true;
            let messages = [];

            this.querySelectorAll("input[required], select[required]").forEach(input => {
                if (!input.value.trim()) {
                    valid = false;
                    messages.push(`• ${input.previousElementSibling.innerText.replace(':','')}`);
                    input.classList.add("input-error");
                } else {
                    input.classList.remove("input-error");
                }
            });

            if (!valid) {
                e.preventDefault();
                alert("⚠️ Debe completar los siguientes campos:\n\n" + messages.join("\n"));
            }
        });
    </script>

</body>
</html>
